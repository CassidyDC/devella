{
  "name": "devella",
  "displayName": "Devella",
  "version": "1.0.0",
  "description": "Interactive CLI for setting up a local WordPress development server with DDEV",
  "author": {
    "name": "CassidyDC",
    "email": "hello@cassidydc.com",
    "url": "https://cassidydc.com"
  },
  "bin": {
    "devella": "./bin/devella.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "main": "src/cli/run.js",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "homepage": "https://github.com/CassidyDC/devella/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/CassidyDC/devella"
  },
  "bugs": {
    "url": "https://github.com/cassidydc/devella/issues"
  },
  "license": "MIT",
  "keywords": [
    "CassidyDC",
    "DDEV",
    "development server",
    "local server",
    "WordPress"
  ],
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "enquirer": "^2.4.1",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-multiline-arrays": "^4.1.11"
  },
  "scripts": {
    "test": "node --test",
    "test:package": "node scripts/check-package.js",
    "check": "npx prettier . --check",
    "format": "npx prettier . --write",
    "lint:docs": "npx markdownlint-cli2 \"**/*.md\"",
    "lint:docs:fix": "npx markdownlint-cli2 \"**/*.md\" --fix",
    "lint:scripts": "eslint . --max-warnings 0",
    "lint:scripts:fix": "npx eslint --fix"
  },
  "allowScripts": {
    "lefthook@2.1.10": true,
    "unrs-resolver@1.12.2": true
  }
}
